# Base URL API - "/api" karena backend-nya sekarang Next.js Route Handler
# di project yang sama (src/app/api/...), bukan server terpisah.
NEXT_PUBLIC_API_BASE_URL=/api

# Auth, User, dan Role sudah punya backend asli - flag ini cuma ngefek ke
# modul yang MASIH mock (Vendor/Customer/Payment Voucher/Notifications).
NEXT_PUBLIC_USE_MOCK_API=true
