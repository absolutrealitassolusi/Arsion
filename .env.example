# Copy file ini jadi ".env" dan isi nilai aslinya (JANGAN commit .env).

# Connection string Postgres - dari Supabase (Project Settings -> Database ->
# Connection string -> tab "ORM" -> Prisma). Pakai yang KONEKSI LANGSUNG
# (port 5432), bukan yang lewat pooler (port 6543/?pgbouncer=true) - lihat
# komentar di .env buat alasannya.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# String random buat sign/verify session cookie (JWT). Generate misalnya
# lewat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-string-random-yang-panjang"

# Supabase Storage (attachment/bukti PV, tanda tangan user) - dari Supabase
# Dashboard -> Project Settings -> API.
# SUPABASE_URL = "Project URL".
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY = "service_role" secret key (BUKAN "anon public").
# Ini setara akses penuh ke seluruh project Supabase - PERINGATAN: JANGAN
# PERNAH kasih prefix "NEXT_PUBLIC_", dan jangan pernah diimpor dari kode
# yang jalan di browser (cuma dipakai server-side, lihat src/lib/file-storage.ts).
SUPABASE_SERVICE_ROLE_KEY="ganti-dengan-service-role-key-asli"

# Setelah 2 variabel di atas diisi, jalankan "npm run storage:setup" sekali
# buat bikin private bucket-nya (idempotent, aman dijalankan ulang).

# Supabase Auth (login/session/reset password) - dari Supabase Dashboard ->
# Project Settings -> API, sama tempat ambil SUPABASE_URL/SERVICE_ROLE_KEY
# di atas.
# NEXT_PUBLIC_SUPABASE_URL - Project URL, SAMA persis kaya SUPABASE_URL di
# atas, cuma perlu di-expose ke browser (makanya prefix beda).
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY - "anon public" key (BUKAN service_role) -
# aman diexpose ke client, itu memang fungsinya.
NEXT_PUBLIC_SUPABASE_ANON_KEY="ganti-dengan-anon-public-key-asli"

# Setelah 2 variabel di atas diisi, jalankan "npm run auth:migrate-users"
# sekali buat migrasi user existing ke Supabase Auth (cetak daftar password
# sementara di akhir - baca output-nya, jangan di-skip).
